generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  o_level
  manager
  assistant_manager
  executive
}

enum UserTheme {
  dark
  light
}

enum TaskStatus {
  pending
  in_progress
  done
  blocked
}

enum TaskPriority {
  very_high
  high
  medium
  low
}

enum TaskType {
  universal
  private
  personal
}

enum ProjectStatus {
  in_pipeline
  in_onboarding
  active
  done
  expired
  canceled
}

enum AttachmentType {
  link
  image
  pdf
}

enum LogEntryType {
  task_created
  task_edited
  task_status
  task_priority
  task_due
  task_muted
  task_unmuted
  comment
  user_created
  user_edited
  user_muted
  user_unmuted
  report
  report_edited
  login
  settings
  vault_created
  vault_edited
  vault_deleted
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String   // bcrypt hash — never store plaintext
  role             UserRole @default(executive)
  designation      String   @default("")
  department       String   @default("")
  responsibilities String   @default("")
  avatar           String?
  muted            Boolean  @default(false)
  sessionVersion   Int      @default(0) // for invalidating sessions on password change or role update
  theme            UserTheme @default(dark)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  createdTasks       Task[]              @relation("TaskCreator")
  assignedTasks      TaskAssignee[]
  comments           Comment[]
  attachmentsAdded   Attachment[]
  dailyReports       DailyReport[]
  notifications      Notification[]
  logEntriesActed    LogEntry[]          @relation("LogActor")
  monthlyCompletions MonthlyCompletion[]
  createdMonthly     MonthlyTask[]       @relation("MonthlyCreator")
  monthlyAssignees   MonthlyTaskAssignee[]
  projectsCreated    Project[]           @relation("ProjectCreator")
  projectMembers     ProjectMember[]
  projectDocsAdded   ProjectDoc[]
  vaultCreated       VaultEntry[]        @relation("VaultCreator")
  vaultAccess        VaultAccessEntry[]

  @@index([email])
  @@index([role])
  @@index([muted])
}


